# Server
PORT=5000
NODE_ENV=development

# Baza lokalno (kad NODE_ENV nije production)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=car_wash_db

# Baza na serveru (koristi se kad je NODE_ENV=production)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Adresa frontenda, za CORS
FRONTEND_URL=https://car-wash-bogdan.netlify.app

# JWT
JWT_SECRET=your_long_random_secret_here
JWT_EXPIRES_IN=7d

# Registracija je zatvorena dok ovo nije true
ALLOW_REGISTER=false
